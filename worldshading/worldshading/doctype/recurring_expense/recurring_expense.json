   "read": 1,
   "write": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "delete": 1,
   "role": "Accounts Manager"
  },
  {
   "create": 1,
   "read": 1,
   "write": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "delete": 1,
   "role": "System Manager"
  }
 ],
 "search_fields": "expense_name,provider_name,registered_email,service_identifier",
 "sort_field": "modified",
